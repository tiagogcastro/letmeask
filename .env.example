# Firebase web app config (public by design, but keep it out of git).
# Console: Project settings > General > Your apps > Web app > SDK setup and configuration
VITE_API_KEY=""
VITE_AUTH_DOMAIN=""
VITE_DATABASE_URL=""
VITE_PROJECT_ID=""
VITE_STORAGE_BUCKET=""
VITE_MESSAGING_SENDER_ID=""
VITE_APP_ID=""

# Set to "true" to run against the local Firebase emulators (npm run sandbox)
# instead of the real project. See README quickstart.
VITE_USE_EMULATORS="false"
