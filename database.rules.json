{
  "rules": {
    "rooms": {
      ".read": true,
      "$roomId": {
        ".write": "auth != null && (!data.exists() || data.child('author/id').val() === auth.uid)",
        "title": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
        },
        "questions": {
          "$questionId": {
            ".write": "auth != null && ((!data.exists() && root.child('rooms').child($roomId).child('endedAt').val() === false) || root.child('rooms').child($roomId).child('author/id').val() === auth.uid)",
            "content": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 400"
            },
            "likes": {
              "$likeId": {
                ".write": "auth != null && ((!data.exists() && root.child('rooms').child($roomId).child('endedAt').val() === false) || data.child('authorId').val() === auth.uid)",
                "authorId": {
                  ".validate": "newData.val() === auth.uid"
                }
              }
            }
          }
        }
      }
    }
  }
}
